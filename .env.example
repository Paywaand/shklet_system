# --- Database ---
# PostgreSQL. On Railway, use the Postgres service's connection URL (Connect tab).
# Locally, point this at any Postgres instance, e.g.
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shklet"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# --- Auth ---
# Secret used to sign session JWTs. MUST be changed in production.
# Generate one with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# How long a login session lasts (in days).
SESSION_DAYS="7"

# --- App ---
# Public URL of the app (used for nothing email-related; informational/CORS-safe).
NEXT_PUBLIC_APP_NAME="Shklet"

# --- Cloudflare R2 backups (off-site DB backups) ---
# When ALL four are set, a daily 03:00 cron dumps the Postgres database (via
# pg_dump) and uploads the .sql snapshot to a private R2 bucket, timestamped,
# kept forever.
# Leave them unset to disable backups (e.g. local dev).
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# S3-compatible endpoint, e.g. https://<accountid>.r2.cloudflarestorage.com
R2_ENDPOINT=""
R2_BUCKET_NAME=""
# Optional: override the backup schedule (5-field cron). Default: "0 3 * * *".
# BACKUP_CRON="0 3 * * *"
