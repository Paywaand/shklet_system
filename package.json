{
  "name": "shklet-pos",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && cp -r .next/static .next/standalone/.next/static && cp -r public .next/standalone/public",
    "start": "next start",
    "start:prod": "prisma migrate deploy && (npm run seed || echo 'seed step skipped') && next start -H 0.0.0.0",
    "lint": "next lint",
    "setup": "prisma migrate dev --name init && npm run seed",
    "seed": "tsx prisma/seed.ts",
    "reset-admin": "tsx prisma/reset-admin.ts",
    "demo": "tsx prisma/demo.ts",
    "backup": "tsx scripts/backup-now.ts",
    "backup:incremental": "tsx scripts/incremental-backup-now.ts",
    "restore": "tsx scripts/restore.ts",
    "db:reset": "prisma migrate reset --force && npm run seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1063.0",
    "@prisma/client": "^5.22.0",
    "@sentry/nextjs": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.3",
    "jose": "^5.9.6",
    "lucide-react": "^0.460.0",
    "next": "15.5.19",
    "node-cron": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.6",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.10",
    "prisma": "^5.22.0",
    "puppeteer-core": "^23.11.1",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
