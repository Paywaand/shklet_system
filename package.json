{
  "name": "shklet-pos",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && cp -r .next/static .next/standalone/.next/static && cp -r public .next/standalone/public",
    "start": "node .next/standalone/server.js",
    "start:prod": "prisma migrate deploy && (npm run seed || echo 'seed step skipped') && HOSTNAME=0.0.0.0 node .next/standalone/server.js",
    "lint": "next lint",
    "setup": "prisma migrate dev --name init && npm run seed",
    "seed": "tsx prisma/seed.ts",
    "import:menu": "tsx prisma/import-menu.ts",
    "migrate:modifier-prices": "tsx prisma/migrate-modifier-prices.ts",
    "reset-admin": "tsx prisma/reset-admin.ts",
    "demo": "tsx prisma/demo.ts",
    "backup": "tsx scripts/backup-now.ts",
    "backup:incremental": "tsx scripts/incremental-backup-now.ts",
    "restore": "tsx scripts/restore.ts",
    "db:reset": "prisma migrate reset --force && npm run seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@prisma/client": "^5.22.0",
    "@sentry/nextjs": "^10.69.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.3",
    "jose": "^6.2.8",
    "lucide-react": "^1.28.0",
    "next": "15.5.19",
    "node-cron": "^4.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.1.2",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.25",
    "prisma": "^5.22.0",
    "puppeteer-core": "^25.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
